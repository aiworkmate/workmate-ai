# Cloudflare local/runtime variables for WorkMate.
# Copy to .dev.vars for local wrangler dev, or set these as Worker secrets/vars in Cloudflare.

APP_ORIGIN=https://your-cloudflare-domain.workers.dev
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub-first external brain toggle. Leave blank to use same-origin /api/chat.
VITE_BRAIN_API_BASE_URL=
VITE_BRAIN_CHAT_URL=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key

# AI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
AI_ENDPOINT_STYLE=responses

# Optional live-data providers
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
NEWS_API_KEY=
MAPS_API_KEY=

# Runtime tuning
MAX_UPLOAD_MB=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
