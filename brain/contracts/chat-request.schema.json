{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrainChatRequest",
  "type": "object",
  "required": ["conversationId", "messages"],
  "properties": {
    "conversationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": ["string", "null"] },
    "mode": { "type": "string", "enum": ["general", "research", "coding", "planning", "business", "medical"] },
    "enableMemory": { "type": "boolean" },
    "enableLive": { "type": "boolean" },
    "preferredAgent": { "type": ["string", "null"] },
    "preferredEffort": { "type": "string", "enum": ["fast", "standard", "deep"] },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 20000 }
        }
      }
    }
  }
}
